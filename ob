QEMU_LAUNCH_BOOTLOADER_UBOOT_NODTB=""
QEMU_LAUNCH_BOOTLOADER_UBOOT_DTB=""
QEMU_LAUNCH_BOOTLOADER_BL31=""
QEMU_LAUNCH_BOOTLOADER_OPTEE=""
QEMU_LAUNCH_BOOTLOADER_UBOOT_SIZE=""
