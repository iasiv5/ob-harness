# === Colors ===
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color
PROMPT_PREFIX='\033[38;2;255;210;80mob-harness>\033[0m'


# === sourced lib 分区(以下 lib/*.sh 均被 ob source; OB_ENTRY_DIR 须在 source 前算好) ===
OB_ENTRY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# invocation prefix(提示文案回显用户敲法; ob 未装 PATH): source/test 模式(OB_NO_MAIN)外部注入优先(ob_loader export ./ob),
# 普通 CLI 强制 $0(防环境 OB_CMD=ob 污染回显 bare ob)。须在 source lib 前完成注入(lib 不落兜底)。
if [[ -n "${OB_NO_MAIN:-}" ]]; then
    OB_CMD="${OB_CMD:-$0}"
else
    OB_CMD="$0"
fi
for f in "$OB_ENTRY_DIR"/lib/*.sh; do
    # shellcheck disable=SC1090
    source "$f"
done
# === 入口 (parse_args / usage / main) ===

parse_args() {
    DEV_ARGS=()        # 重置(OB_NO_MAIN 多次调用测试防残留)
    TEST_QEMU_ARGS=()
    if [[ $# -lt 1 ]]; then
        COMMAND=""
        return 0
    fi

    # Handle global --help/-h before dispatching to subcommands
    if [[ "$1" == "-h" || "$1" == "--help" ]]; then
        usage
        exit 0
    fi

    COMMAND="$1"
    shift

    case "$COMMAND" in
        init)
            if [[ $# -gt 0 ]] && [[ "$1" != -* ]]; then
                MACHINE="$1"
                shift
            fi
            ;;
        status)
            if [[ $# -gt 0 ]] && [[ "$1" != -* ]]; then
                MACHINE="$1"
                shift
            fi
            ;;
        build)
            if [[ $# -gt 0 ]] && [[ "$1" != -* ]]; then
                MACHINE="$1"
                shift
            fi
            ;;
        start-qemu)
            if [[ $# -gt 0 ]] && [[ "$1" != -* ]]; then
                MACHINE="$1"
                shift
            fi
            ;;
        stop-qemu)
            if [[ $# -gt 0 ]] && [[ "$1" != -* ]]; then
                MACHINE="$1"
                shift
            fi
            ;;
        deploy-to-qemu)
            if [[ $# -gt 0 ]] && [[ "$1" != -* ]]; then
                MACHINE="$1"
                shift
            fi
            ;;
        test-qemu)
            if [[ $# -gt 0 ]] && [[ "$1" != -* ]]; then
                MACHINE="$1"
                shift
            fi
            # 命令私有参数(--suite/--ar/--report/-v/-d)透传给 cmd_test_qemu;
            # set -- 清空,防全局 option while 把 --suite 当 Unknown option exit 1(对照 dev 分支)
            TEST_QEMU_ARGS=("$@")
            set --
            ;;
        dev)
            # dev 子命令的私有参数(--machine/二级子命令)透传给 cmd_dev;
            # set -- 清空,防下面的全局 option while 把 --machine 当未知选项退出
            DEV_ARGS=("$@")
            set --
            ;;
        *)
            error "Unknown command: $COMMAND"
            usage
            exit 1
            ;;
    esac

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|-D|--dry-run)    DRY_RUN=1; shift ;;
            -s|-S|--skip-deps)   SKIP_DEPS=1; shift ;;
            -u|-U|--url)
                if [[ $# -lt 2 ]]; then
                    error "Missing value for --url"
                    usage
                    exit 1
                fi
                OPENBMC_REPO_URL="$2"
                shift 2
                ;;
            -v|-V|--verbose)  VERBOSE=1; shift ;;
            -h|-H|--help)     usage; exit 0 ;;
            --ssh-port)
                if [[ $# -lt 2 ]]; then error "Missing value for --ssh-port"; exit 1; fi
                QEMU_SSH_PORT="$2"; shift 2 ;;
            --redfish-port)
                if [[ $# -lt 2 ]]; then error "Missing value for --redfish-port"; exit 1; fi
                QEMU_REDFISH_PORT="$2"; shift 2 ;;
            --ipmi-port)
                if [[ $# -lt 2 ]]; then error "Missing value for --ipmi-port"; exit 1; fi
                QEMU_IPMI_PORT="$2"; shift 2 ;;
            --http-port)
                if [[ $# -lt 2 ]]; then error "Missing value for --http-port"; exit 1; fi
                QEMU_HTTP_PORT="$2"; shift 2 ;;
            --serial-log)
                if [[ $# -lt 2 ]]; then error "Missing value for --serial-log"; exit 1; fi
                QEMU_SERIAL_LOG="$2"; shift 2 ;;
            --no-wait)  QEMU_NO_WAIT=1; shift ;;
            --force)    QEMU_FORCE=1; shift ;;
            --all)      QEMU_STOP_ALL=1; shift ;;
            *)             error "Unknown option: $1"; usage; exit 1 ;;
        esac
    done
}

usage() {
    cat <<EOF
Usage: $OB_CMD [command] [options] [arguments]

Run without arguments to enter interactive menu mode.

Commands:
  init           [<machine>]  One-click initialize OpenBMC dev environment
  build          [<machine>]  Build an initialized machine's image (interactive if omitted; uninitialized → exit-code 3, run init first)
  status                      Show current OpenBMC source binding status
  start-qemu     [<machine>]  Launch QEMU with built BMC image
  stop-qemu      [<machine>]  Stop a running QEMU instance
  deploy-to-qemu [<machine>]  Rebuild image and restart QEMU for clean verification
  test-qemu      [<machine>]  Run <machine>'s baseline AR probes on its running QEMU instance (probe-only; pass/fail/skip/xfail/xpass; --dry-run lists ARs without an instance)
  dev            [--machine <machine>] <list|modify|build|refresh|reset|status|finish>  Develop recipes via devtool (TTY prompts if omitted)

Global Options:
  -d, --dry-run         Print actions without executing
  -v, --verbose         Verbose output
  -h, --help            Show this help

init Options:
  -s, --skip-deps       Reuse existing deps.json, skip dependency resolution
  -u, --url <url>       Use a custom OpenBMC repository URL

start-qemu Options:
  --ssh-port <port>       SSH port forwarding    (default: 2222)
  --redfish-port <port>   Redfish port forwarding (default: 2443)
  --ipmi-port <port>      IPMI port forwarding    (default: 2623, UDP)
  --http-port <port>      HTTP port forwarding    (no default; set to enable)
  --serial-log <path>     Serial log file path    (default: ~/tmp/qemu-<machine>-serial.log)
  --no-wait               Don't wait for BMC to become ready
  --force                 Kill existing instance without confirmation

stop-qemu Options:
  --force                 Stop without confirmation
  --all                   Stop all running QEMU instances

deploy-to-qemu Options:
  Boundary: build-first mutation — deploy may inspect the current QEMU
            instance and ask for confirmation first, but it does not stop
            or mutate QEMU until after a successful image build. Build
            failure leaves QEMU untouched and exits 1. If a previous
            instance was running, its forwarded ports are reused unless
            CLI port flags were provided; otherwise deploy starts fresh
            with default/env ports. User abort exits 2; instance drift
            during build exits 3.

test-qemu Options:
  <machine>               Whose baseline to test (required positional; a RUNNING instance is required unless --dry-run)
  --suite <name>          Only run ARs in this suite
  --ar <id>               Only run the named AR
  --report <path>         Dump JSON report to PATH
  Environment:
    OB_TQ_USER / OB_TQ_PASSWORD  Redfish creds — env wins over ar_probes.yaml
                    auth (keeps secrets out of 'ps'; environ is owner-only)
    OB_TQ_TIMEOUT  Per-probe HTTP timeout seconds (default 10)
  Boundary: probe-only — does NOT boot or tear down QEMU; reads the Redfish port
            from the instance's PID file (no port overrides honored). With no
            running instance it exits 3 and will NOT boot one — run
            '$OB_CMD start-qemu <machine>' first. With --dry-run no instance is
            needed — it lists ARs + applicability only.
  baseline dir (lineage-routed, per ADR-0025/0026; lineage is judged on the
            source label alone — the QEMU binary dir derives from the same
            label, not an independent factor): community lineage (community
            source label) → tests/baseline/<machine>; custom lineage (any
            non-community source label) → contexts/baseline/<machine>. No
            cross-lineage fallback — attribution stays closed.
  Verdict (per AR): pass / fail / skip / xfail / xpass / error. skip/xfail/xpass
            do NOT affect the exit-code. error = a probe could not get a clean
            BMC answer (transport/timeout/schema) — infra, NOT a baseline miss.
            Only an applicable AR that actually fails causes exit-code 1.
  Exit codes (test-qemu-specific — they OVERRIDE the global "1 = broken" line below):
            0   All applicable ARs passed.
            1   α truth: one or more applicable ARs failed — the BMC does not
                meet its baseline. This is NOT "test-qemu broken"; read the
                fail rows + report.
            3   Precondition missing (no running instance / no baseline dir), OR
                a probe hit a transient infra error mid-run (VERDICT: ERROR) —
                the instance may be fine; re-run / check connectivity, do NOT
                treat it as a baseline failure.

Exit Codes:
  0   Success (or benign no-op)
  1   Failure — broken, or usage error (e.g. unknown option)
  2   Cancelled by user (not a failure)
  3   Precondition missing (e.g. machine not initialized / not built);
      satisfy it via ob (run the suggested '$OB_CMD ...' first), then retry

Environment Variables (command scope shown in parentheses; matching CLI
flags override env values where available):
  OB_OPENBMC_URL          Custom OpenBMC repository URL (init)
  OB_QEMU_SSH_PORT        QEMU launch SSH port override (start-qemu/deploy-to-qemu)
  OB_QEMU_REDFISH_PORT    QEMU launch Redfish port override (start-qemu/deploy-to-qemu)
  OB_QEMU_IPMI_PORT       QEMU launch IPMI port override (start-qemu/deploy-to-qemu)
  OB_QEMU_HTTP_PORT       QEMU launch HTTP port override (start-qemu/deploy-to-qemu)
  OB_QEMU_SERIAL_LOG      QEMU launch serial log path (start-qemu/deploy-to-qemu)
  OB_QEMU_BINARY_URL      QEMU binary provisioning (start-qemu/deploy-to-qemu)
  OB_NPM_REGISTRY         Image build npm registry override; set empty to disable auto-detection (build/deploy-to-qemu)

Examples:
  $OB_CMD init                          # List machines and choose interactively
  $OB_CMD init romulus                  # Initialize romulus machine
  $OB_CMD init romulus -d               # Preview what would be done
  $OB_CMD init romulus --url https://example.com/openbmc.git
  $OB_CMD build romulus                 # Build romulus non-interactively
  $OB_CMD build romulus -d              # Preview the build without running bitbake
  $OB_CMD start-qemu romulus            # Launch romulus in QEMU
  $OB_CMD start-qemu romulus --ssh-port 22223
  $OB_CMD stop-qemu romulus             # Stop romulus QEMU instance
  $OB_CMD stop-qemu --all               # Stop all running instances
  $OB_CMD deploy-to-qemu romulus        # Rebuild romulus image + restart QEMU (port-reuse if running)
  $OB_CMD test-qemu romulus --suite smoke  # Run the 8-AR smoke gate (needs a running instance: start-qemu first)
  $OB_CMD test-qemu romulus --ar SMOKE-03 -v    # Re-run one AR with fail detail
  $OB_CMD dev --machine romulus list ipmi    # Search recipes matching 'ipmi'
  $OB_CMD dev --machine romulus modify phosphor-ipmi-host   # devtool modify, outputs srctree
  $OB_CMD dev --machine romulus build phosphor-ipmi-host  # devtool build single recipe (do_build); exit-code carries result
  $OB_CMD dev --machine romulus refresh     # Regenerate recipe metadata cache
  $OB_CMD dev --machine romulus reset phosphor-ipmi-host  # devtool reset, outputs disposition JSON
  $OB_CMD dev --machine romulus finish phosphor-ipmi-host  # devtool finish, lands patches to layer, outputs JSON
  $OB_CMD dev --machine romulus status             # List modified recipes (outputs JSONL)
  $OB_CMD dev                               # Interactive: pick machine, then pick subcommand (TTY)
EOF
}

main() {
    SECONDS=0
    parse_args "$@"
    detect_harness_root

    if [[ -z "$COMMAND" ]]; then
        cmd_menu
        return $?
    fi

    # CLI mode
    # ob dev 是 porcelain agent-facing 命令: dispatch 在 show_logo 前(跳过 logo, stdout 只输出 JSONL/srctree)
    if [[ "$COMMAND" == "dev" ]]; then
        cmd_dev "${DEV_ARGS[@]}"
        return $?
    fi
    show_logo

    if [[ "$COMMAND" == "status" ]]; then
        cmd_status
        return $?
    fi

    if [[ "$COMMAND" == "build" ]]; then
        cmd_build
        return $?
    fi

    if [[ "$COMMAND" == "start-qemu" ]]; then
        cmd_start_qemu
        return $?
    fi

    if [[ "$COMMAND" == "stop-qemu" ]]; then
        cmd_stop_qemu
        return $?
    fi

    if [[ "$COMMAND" == "deploy-to-qemu" ]]; then
        cmd_deploy_to_qemu
        return $?
    fi

    if [[ "$COMMAND" == "test-qemu" ]]; then
        cmd_test_qemu "${TEST_QEMU_ARGS[@]}"
        return $?
    fi

    cmd_init
}

if [[ -z "${OB_NO_MAIN:-}" ]]; then
    main "$@"
fi
